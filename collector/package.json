{
  "name": "headway-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Records the Madison Metro GTFS-Realtime feeds around the clock on Cloudflare's free plan.",
  "scripts": {
    "build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test \"test/*.test.mjs\"",
    "deploy": "WRANGLER_SEND_METRICS=false wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.147.0"
  }
}
