    "Usually at this stop": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバス停の普段の運行"
          }
        }
      }
    },
    "Early means more than a minute before the timetable, late more than five minutes after. Ranges next to live times show where the bus turned up in 9 of 10 past cases for predictions this far ahead.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早着は時刻表より1分以上早い場合、遅れは5分以上遅い場合です。ライブの時刻の横の範囲は、同じくらい先の予測のとき、過去10回中9回でバスが来た範囲です。"
          }
        }
      }
    },
